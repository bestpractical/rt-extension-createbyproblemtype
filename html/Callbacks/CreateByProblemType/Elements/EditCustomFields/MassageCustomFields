<%INIT>
return
    if !RT->Config->Get( 'CreateByProblemType', $session{'CurrentUser'} )
    || ( $Object && ( !$Object->isa('RT::Ticket') || $Object->Id ) );

$CustomFields->Limit(
    FIELD           => 'Name',
    OPERATOR        => '!=',
    VALUE           => 'Problem Type',
    CASESENSITIVE   => 0,
    ENTRYAGGREGATOR => 'AND',
);
</%INIT>

<%ARGS>
$Object
$CustomFields
</%ARGS>
